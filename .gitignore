.claude/
*.log

# Build output. Build-RSFind.cmd regenerates it from the .cs sources.
*.exe
*.pdb

# Distribution zip, built by tools\Make-Dist.ps1. It is a release asset rather
# than a tracked file: committing a binary that has to be rebuilt on every
# source change is how a repo ends up shipping a stale one.
dist/

# Scratch corpora written by the test harness.
testdata/
